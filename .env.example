# Foundry deploy — copy to .env (gitignored) and fill before broadcast
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_deployer_private_key

# solarking seal bridge (cast recipes; solarking never loads PRIVATE_KEY)
SOLARKING_CONTRACT=
SOLARKING_CROWN_COMMAND=
SOLARKING_SBT=
SOLARKING_RPC_URL=
SOLARKING_CHAIN_ID=84532
# SOLARKING_PASSPHRASE=

# Deploy Phase 2B (example):
# forge script script/DeployPhase2B.s.sol --rpc-url $BASE_SEPOLIA_RPC_URL --broadcast --private-key $PRIVATE_KEY
