# Foundry deploy — copy to .env and fill before: forge script script/DeployVortex369.s.sol --broadcast
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_deployer_private_key

# Optional solarking seal bridge (used by cast recipes; solarking never loads PRIVATE_KEY)
SOLARKING_CONTRACT=
SOLARKING_RPC_URL=
SOLARKING_CHAIN_ID=1
# SOLARKING_PASSPHRASE=  # enable encrypted kingdom_ledger.json.enc